# Production env file for the Docker compose stack. Copy to `.env` on the
# deploy host (NOT committed) and tighten permissions: `chmod 600 .env`.

# -----------------------------------------------------------------------------
# Postgres (inside-cluster; app reaches it by service name `db`)
# -----------------------------------------------------------------------------
POSTGRES_USER=openmasjid
POSTGRES_PASSWORD=CHANGE-ME-to-a-strong-random-password
POSTGRES_DB=openmasjid

# Database URI the app uses. Service name `db`, port 5432 (internal).
DATABASE_URI=postgres://openmasjid:CHANGE-ME-to-a-strong-random-password@db:5432/openmasjid

# -----------------------------------------------------------------------------
# Payload
# -----------------------------------------------------------------------------
# openssl rand -hex 32
PAYLOAD_SECRET=replace-with-32-byte-random-hex

# Public URL the site is served at (used for reset-password / preview links).
NEXT_PUBLIC_SERVER_URL=https://openmasjid.app

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@openmasjid.app
EMAIL_FROM_NAME=OpenMasjid

# -----------------------------------------------------------------------------
# Scheduled publishing cron (shared secret between app + cron sidecar)
# -----------------------------------------------------------------------------
# openssl rand -hex 32
CRON_SECRET=replace-with-another-32-byte-random-hex

# -----------------------------------------------------------------------------
# Media storage
# -----------------------------------------------------------------------------
# Host path that will be bind-mounted into the app container at
# /app/public/media. Point this at an NFS mount from TrueNAS for durable
# off-box storage with ZFS snapshots. Example:
#   MEDIA_PATH=/mnt/truenas/openmasjid-media
MEDIA_PATH=./media

# -----------------------------------------------------------------------------
# Network binding for the app's published port
# -----------------------------------------------------------------------------
# Default 0.0.0.0 publishes on every interface — required when NPM lives on
# another host on the LAN and proxies to http://<this-host-ip>:${APP_HOST_PORT}.
# Set to 127.0.0.1 if NPM runs on the same host (only loopback access needed).
APP_BIND=0.0.0.0

# Host port to publish on. The container always listens on 3000 internally;
# this lets you avoid collisions with other services on the host
# (e.g. another container already holding port 3000). Default 3000.
APP_HOST_PORT=3000

# -----------------------------------------------------------------------------
# Schema auto-sync
# -----------------------------------------------------------------------------
# Set to "true" to have Payload auto-sync the schema on boot in production
# (useful when standing up a fresh DB without running migrations explicitly).
# Leave unset for proper migration-based deploys.
# PAYLOAD_DB_PUSH=true

# -----------------------------------------------------------------------------
# Image source + auto-deploy (GHCR + Watchtower)
# -----------------------------------------------------------------------------
# The app image is pulled from GHCR. Leave APP_IMAGE unset to track :latest
# (what Watchtower auto-updates). To roll back, pin it to an immutable sha tag,
# e.g. APP_IMAGE=ghcr.io/majidtahir1/open-masjid:sha-1a2b3c4 — Watchtower won't
# clobber a pinned sha. Return to auto-updates by unsetting it again.
# APP_IMAGE=ghcr.io/majidtahir1/open-masjid:latest

# Path to the Docker auth config Watchtower mounts to pull the private GHCR
# image. Defaults to ~/.docker/config.json (where `docker login ghcr.io`
# writes). Most Docker Compose v2 builds expand ~, but if yours does not, set
# this to an ABSOLUTE path, e.g. /root/.docker/config.json or
# /home/deploy/.docker/config.json.
# DOCKER_CONFIG_PATH=/root/.docker/config.json

# -----------------------------------------------------------------------------
# Deploy notifications (Telegram) — optional
# -----------------------------------------------------------------------------
# Get a bot token from @BotFather; get your chat id from @userinfobot (DM it) or
# the bot's getUpdates. The SAME two values also go in GitHub repo secrets
# (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID) so CI can notify on build/push.
# On the server these drive: (a) Watchtower deploy-event alerts and (b) the
# app's startup migration-failure alert. Leave unset to disable notifications.
# TELEGRAM_BOT_TOKEN=123456789:AAExampleBotTokenFromBotFather
# TELEGRAM_CHAT_ID=987654321
# Enable Watchtower's notifier (requires the two vars above):
# WATCHTOWER_NOTIFICATIONS=shoutrrr
